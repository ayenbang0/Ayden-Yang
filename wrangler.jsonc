{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aydenyang",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "aydenyang.com", "custom_domain": true },
    { "pattern": "www.aydenyang.com", "custom_domain": true }
  ]
}
